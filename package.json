{
  "name": "soap-ehr",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --import tsx --test app/lib/ehr/templates.test.ts app/lib/fhir/store.delete.test.ts scripts/compose-url-environment.test.ts scripts/migrate-mysql-to-postgres.test.ts scripts/omop/transform.test.ts",
    "import:generate": "node --env-file-if-exists=.env --import tsx import/tools/generate-fhir-imports.ts",
    "import:review": "node --env-file-if-exists=.env --import tsx import/tools/review-fhir-imports.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "v1:migrate:deploy": "prisma migrate deploy --schema docs/migration/v1/prisma/schema.prisma",
    "v1:fixture:seed": "prisma db execute --schema docs/migration/v1/prisma/schema.prisma --file docs/migration/v1/fixtures/seed-v1.sql",
    "v1:backup": "sh scripts/backup-v1-mysql.sh",
    "v1:restore": "sh scripts/restore-v1-mysql.sh",
    "v2:backup": "sh scripts/backup-v2-postgres.sh",
    "migrate:mysql-to-postgres": "sh scripts/migrate-mysql-to-postgres.sh",
    "migrate:v1-to-v2": "tsx scripts/migrate-v1-to-v2.ts",
    "omop:etl": "tsx scripts/omop-etl.ts",
    "v2:fixture:seed": "tsx scripts/seed-v2-synthetic.ts",
    "create:user": "tsx scripts/create-auth-user.ts",
    "create:token": "tsx scripts/create-token.ts",
    "revoke:token": "tsx scripts/revoke-token.ts",
    "export:soap-anonymized": "node scripts/get-anonymized-soap-records.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@langchain/anthropic": "^0.3.15",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.50",
    "@langchain/mcp-adapters": "^0.4.5",
    "@prisma/client": "^6.6.0",
    "@react-router/node": "^7.4.0",
    "@react-router/serve": "^7.4.0",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "i18next": "^26.4.2",
    "isbot": "^5.1.29",
    "pg": "^8.23.0",
    "prisma": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^9.0.1",
    "react-router": "^7.4.0",
    "remark-gfm": "^4.0.0",
    "swagger-ui-react": "^5.24.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.4.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "mysql2": "^3.24.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.14",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
