generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id                  Int       @id @default(autoincrement())
  name                String
  gender              String
  birthDate           DateTime? @map("birth_date") @db.Date
  isDraft             Boolean   @default(false) @map("is_draft")
  active              Boolean   @default(true)
  mergedIntoPatientId Int?      @map("merged_into_patient_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  mergedInto                    Patient?                       @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id])
  replaces                      Patient[]                      @relation("PatientMerge")
  telecom                       ContactPoint[]
  identifier                    Identifier[]
  appointments                  Appointment[]
  encounterDrafts               EncounterDraft[]
  clinicalAttachments           ClinicalAttachment[]
  contacts                      Contact[]
  ehr                           EhrRecord?
  clinicalDocumentWebhookEvents ClinicalDocumentWebhookEvent[]
}

model Contact {
  id           Int      @id @default(autoincrement())
  name         String
  relationship String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  patientId Int     @map("patient_id")
  patient   Patient @relation(fields: [patientId], references: [id])
}

model ContactPoint {
  id        Int      @id @default(autoincrement())
  system    String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  patientId Int?     @map("patient_id")
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@unique([system, value, patientId])
}

model Identifier {
  id        Int      @id @default(autoincrement())
  system    String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  patientId Int?     @map("patient_id")
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@unique([system, value])
}

model Appointment {
  id              Int      @id @default(autoincrement())
  patientId       Int      @map("patient_id")
  start           DateTime
  end             DateTime
  status          String
  appointmentType String   @map("appointment_type")
  // Patient's answer to the reminder: pending | confirmed | declined | no_response.
  confirmationStatus String    @default("pending") @map("confirmation_status")
  confirmationAt     DateTime? @map("confirmation_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  patient             Patient              @relation(fields: [patientId], references: [id])
  compositionVersions CompositionVersion[]
}

model GeneralSetting {
  id        Int      @id @default(autoincrement())
  property  String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
}

model AuthUser {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")
  crm       String
  crmUf     String   @map("crm_uf")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tokens                        AuthToken[]
  contributions                 Contribution[]
  compositionVersions           CompositionVersion[]
  encounterDrafts               EncounterDraft[]
  clinicalAttachments           ClinicalAttachment[]
  attachmentPluginExecutions    AttachmentPluginExecution[]
  clinicalDocumentWebhookEvents ClinicalDocumentWebhookEvent[]
  pluginCredentials             UserPluginCredential[]
  auditLogs                     AuditLog[]

  @@unique([crm, crmUf])
}

model AuthToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @map("token_hash")
  isActive   Boolean   @default(true) @map("is_active")
  // What the token may reach: full | reminders (see app/lib/auth-scope.ts).
  scope      String    @default("full")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  userId Int      @map("user_id")
  user   AuthUser @relation(fields: [userId], references: [id])

  @@unique([tokenHash])
}

model EhrRecord {
  id        String   @id @default(uuid()) @db.Char(36)
  systemId  String   @default("soap-ehr") @map("system_id")
  patientId Int      @unique @map("patient_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  patient               Patient                @relation(fields: [patientId], references: [id])
  contributions         Contribution[]
  versionedCompositions VersionedComposition[]
}

model Contribution {
  id              String   @id @default(uuid()) @db.Char(36)
  ehrId           String   @map("ehr_id") @db.Char(36)
  committerUserId Int      @map("committer_user_id")
  changeType      String   @default("creation") @map("change_type")
  description     String?
  committedAt     DateTime @default(now()) @map("committed_at")

  ehr       EhrRecord            @relation(fields: [ehrId], references: [id])
  committer AuthUser             @relation(fields: [committerUserId], references: [id])
  versions  CompositionVersion[]

  @@index([ehrId, committedAt])
  @@index([committerUserId])
}

model VersionedComposition {
  id        String   @id @default(uuid()) @db.Char(36)
  ehrId     String   @map("ehr_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  ehr      EhrRecord            @relation(fields: [ehrId], references: [id])
  versions CompositionVersion[]

  @@index([ehrId, createdAt])
}

model ArchetypeDefinition {
  id          String   @id
  rmType      String   @map("rm_type")
  concept     String
  language    String   @default("pt-BR")
  definition  Json
  contentHash String   @map("content_hash") @db.Char(64)
  createdAt   DateTime @default(now()) @map("created_at")

  compositionVersions CompositionVersion[]
}

model TemplateDefinition {
  id                  String   @id
  rootArchetypeId     String   @map("root_archetype_id")
  name                String
  version             String
  language            String   @default("pt-BR")
  operationalTemplate Json     @map("operational_template")
  contentHash         String   @map("content_hash") @db.Char(64)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")

  compositionVersions CompositionVersion[]
}

model CompositionVersion {
  id                     String   @id @default(uuid()) @db.Char(36)
  versionedCompositionId String   @map("versioned_composition_id") @db.Char(36)
  contributionId         String   @map("contribution_id") @db.Char(36)
  precedingVersionId     String?  @map("preceding_version_id") @db.Char(36)
  templateId             String   @map("template_id")
  archetypeId            String   @map("archetype_id")
  composerUserId         Int      @map("composer_user_id")
  appointmentId          Int?     @map("appointment_id")
  versionNumber          Int      @default(1) @map("version_number")
  lifecycleState         String   @default("complete") @map("lifecycle_state")
  category               String   @default("event")
  language               String   @default("pt-BR")
  territory              String   @default("BR")
  title                  String
  encounteredAt          DateTime @map("encountered_at")
  content                Json
  contentHash            String   @map("content_hash") @db.Char(64)
  fhirCompositionId      String   @unique @map("fhir_composition_id")
  sourceSystem           String?  @map("source_system")
  sourceRecordId         String?  @map("source_record_id")
  sourceMetadata         Json?    @map("source_metadata")
  committedAt            DateTime @default(now()) @map("committed_at")

  versionedComposition VersionedComposition @relation(fields: [versionedCompositionId], references: [id])
  contribution         Contribution         @relation(fields: [contributionId], references: [id])
  precedingVersion     CompositionVersion?  @relation("CompositionVersionHistory", fields: [precedingVersionId], references: [id])
  followingVersions    CompositionVersion[] @relation("CompositionVersionHistory")
  template             TemplateDefinition   @relation(fields: [templateId], references: [id])
  archetype            ArchetypeDefinition  @relation(fields: [archetypeId], references: [id])
  composer             AuthUser             @relation(fields: [composerUserId], references: [id])
  appointment          Appointment?         @relation(fields: [appointmentId], references: [id])
  clinicalAttachments  ClinicalAttachment[]

  @@unique([versionedCompositionId, versionNumber])
  @@unique([sourceSystem, sourceRecordId])
  @@index([composerUserId])
  @@index([appointmentId])
  @@index([templateId, encounteredAt])
  @@index([archetypeId])
}

model EncounterDraft {
  id            Int      @id @default(autoincrement())
  patientId     Int      @map("patient_id")
  authorUserId  Int      @map("author_user_id")
  appointmentId Int?     @map("appointment_id")
  draftKey      String   @map("draft_key")
  noteType      String   @default("soap") @map("note_type")
  status        String   @default("active")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  author              AuthUser             @relation(fields: [authorUserId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  clinicalAttachments ClinicalAttachment[]

  @@unique([patientId, authorUserId, draftKey])
  @@index([expiresAt])
}

model ClinicalAttachment {
  id                   Int      @id @default(autoincrement())
  patientId            Int      @map("patient_id")
  authorUserId         Int      @map("author_user_id")
  draftId              Int?     @map("draft_id")
  appointmentId        Int?     @map("appointment_id")
  compositionVersionId String?  @map("composition_version_id") @db.Char(36)
  status               String   @default("draft")
  fileName             String   @map("file_name")
  contentType          String   @map("content_type")
  byteSize             Int      @map("byte_size")
  sha256               String
  s3Bucket             String   @map("s3_bucket")
  s3Key                String   @map("s3_key")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  author             AuthUser                    @relation(fields: [authorUserId], references: [id])
  draft              EncounterDraft?             @relation(fields: [draftId], references: [id])
  patient            Patient                     @relation(fields: [patientId], references: [id])
  compositionVersion CompositionVersion?         @relation(fields: [compositionVersionId], references: [id])
  pluginExecutions   AttachmentPluginExecution[]

  @@index([draftId])
  @@index([patientId, status])
  @@index([compositionVersionId])
}

model AttachmentPluginExecution {
  id                Int       @id @default(autoincrement())
  attachmentId      Int       @map("attachment_id")
  pluginId          String    @map("plugin_id")
  requestedByUserId Int       @map("requested_by_user_id")
  externalJobId     String?   @map("external_job_id")
  status            String
  summary           String?   @db.Text
  result            Json?
  error             String?   @db.Text
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  attachment  ClinicalAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  requestedBy AuthUser           @relation(fields: [requestedByUserId], references: [id])

  @@unique([attachmentId, pluginId])
  @@index([pluginId, status])
  @@index([requestedByUserId, status])
}

model UserPluginCredential {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  pluginId        String   @map("plugin_id")
  encryptedSecret String   @map("encrypted_secret") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pluginId])
}

model ClinicalDocumentWebhookEvent {
  id           Int       @id @default(autoincrement())
  patientId    Int       @map("patient_id")
  authorUserId Int       @map("author_user_id")
  state        String
  documentType String    @map("document_type")
  clinicalNote String    @map("clinical_note") @db.Text
  payload      Json?
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author  AuthUser @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([state])
  @@index([patientId, authorUserId, consumedAt], map: "cdwe_patient_author_consumed_idx")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  category   String
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  userId Int?      @map("user_id")
  user   AuthUser? @relation(fields: [userId], references: [id])
}
