# These URLs are consumed inside Docker containers, so use the database service
# DNS names and container ports. URL-encode usernames/passwords that contain
# reserved URL characters before setting the corresponding value.
DATABASE_URL="postgresql://clinic:clinic@soap-ehr-db:5432/soap_ehr"
OMOP_DATABASE_URL="postgresql://clinic:clinic@soap-ehr-db:5432/soap_ehr"
V1_DATABASE_URL="mysql://clinic:clinic@soap-ehr-db-legacy:3306/fhir_soap_record"
APP_PORT="3000"
DB_PORT="5438"
LEGACY_DB_PORT="3306"
SOAP_EHR_DB_NAME="soap_ehr"
V1_DB_NAME="fhir_soap_record"
DB_USER="clinic"
# Generate a strong 12-character password: python3 -c "import secrets,string; chars=string.ascii_letters+string.digits+'!@#$%&*+-_'; print(''.join(secrets.choice(chars) for _ in range(12)))"
DB_PASS="clinic"
LEGACY_DB_USER="clinic"
LEGACY_DB_PASS="clinic"
PORT="3000"
APP_URL="http://localhost:3000"
COOKIE_NAME="clinic_token"
API_DRY_RUN="false"
# Exclusão FHIR existe somente para testes em memória: exige também API_DRY_RUN=true.
FHIR_TEST_DELETE_ENABLED="false"

# Import pipeline - OCR (Mistral)
MISTRAL_API_KEY=""
MISTRAL_OCR_MODEL="mistral-ocr-latest"
MISTRAL_API_BASE_URL="https://api.mistral.ai"

# App LLM layer (LangChain) - used by SOAP plugins (AI Summary, Calc MCP)
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-20250514"
LLM_TOKEN=""

# SOAP plugin: Calc MCP server
MCP_CALC_URL="http://beta.calc.filipelopes.med.br/mcp"

# Attachment plugin: MeuExame processing API
MEUEXAME_API_BASE_URL="http://host.docker.internal:3021"

# ── Document (Docs) plugin ─────────────────────────────────────────────────
# Two URLs that point at the SAME Docs deployment from two different vantage
# points. Getting them mixed up causes 404s on the issued-document webhook.
#
# DOCS_APP_BASE_URL: where the END USER'S BROWSER opens the Docs app. Must be a
# host reachable from the browser (the public/local URL behind your reverse
# proxy), e.g. http://docs.localhost or http://localhost:83. Used to build the
# launch URL the browser is redirected to.
DOCS_APP_BASE_URL="http://docs.localhost"
#
# DOCS_WEBHOOK_BASE_URL: where the DOCS BACKEND CONTAINER calls THIS app back to
# deliver the issued-document webhook. This is a server-to-server call over the
# shared Docker network, so it must be THIS app's own network alias + internal
# port — NOT the Docs nginx host, and NOT the browser URL.
#   - Docker dev (both stacks on the `development` network): http://fhir-soap-record:3000
#   - app running on the host instead of a container:        http://host.docker.internal:3000
# If unset, the app falls back to DOCS_APP_BASE_URL (usually wrong for Docker).
DOCS_WEBHOOK_BASE_URL="http://fhir-soap-record:3000"

# Generate with: openssl rand -base64 32
PLUGIN_SECRET_ENCRYPTION_KEY=""

# Import pipeline scripts (CLI tools in import/tools - separate from app LLM layer)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_API_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_VERSION="2023-06-01"

CLINIC_TIMEZONE_OFFSET="-03:00"

# Object Storage (S3 AWS-like)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="fhir-soap-record"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# PDF attachment compression (Ghostscript). Scanned uploads are downsampled to
# this resolution before hitting S3; the original is kept when the result is
# not smaller. Options: off | 150dpi | 200dpi (default; safe for small print).
ATTACHMENT_PDF_COMPRESSION="200dpi"
